{
  "manifest_version": 3,
  "name": "Autopilot-DM",
  "version": "1.79.0",
  "description": "Enchaîne automatiquement les étapes de l’Aventure ou la chasse (groupe le plus dur d’une zone), résout la vérification de présence, surveille l’énergie, échange des objets entre deux comptes via l’HDV et alerte sur Discord (défaite, énergie basse, boss de chasse).",
  "permissions": ["storage", "alarms"],
  "incognito": "spanning",
  "host_permissions": [
    "https://dofusmasters.houk.fr/*",
    "https://discord.com/*",
    "https://discordapp.com/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["shared.js", "background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "autopilot-dm@yannowitsh",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] },
      "update_url": "https://github.com/Yannowitsh/Autopilot-DM/releases/latest/download/updates.json"
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Autopilot-DM"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dofusmasters.houk.fr/*"
      ],
      "js": [
        "netwatch.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://dofusmasters.houk.fr/*"
      ],
      "js": [
        "shared.js",
        "wanted.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
